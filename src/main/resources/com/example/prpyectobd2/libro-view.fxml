<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="531.0" prefWidth="723.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.prpyectobd2.controller.LibroController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
            <children>
                <Label prefHeight="45.0" prefWidth="178.0" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Gestión de Libros" textFill="#2f7e35">
               <font>
                  <Font name="Goudy Stout" size="12.0" />
               </font></Label>
            <Separator prefHeight="0.0" prefWidth="694.0" style="-fx-background-color: #89c522;" />

                <HBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Título del Libro:" />
                                <TextField fx:id="txtTitulo" promptText="Ej. Clean Code" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Autor:" />
                                <TextField fx:id="txtAutor" promptText="Ej. Robert C. Martin" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Categoría:" />
                                <!-- Aquí está el ComboBox solicitado -->
                                <ComboBox fx:id="cmbCategoria" prefWidth="200.0" promptText="Seleccione..." />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Precio:" />
                                <TextField fx:id="txtPrecio" promptText="Ej. 45.50" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Stock:" />
                                <TextField fx:id="txtStock" promptText="Ej. 15" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Botones de Acción -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#onGuardarLibro" prefWidth="120.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Guardar" />
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#onActualizarTabla" prefWidth="120.0" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Actualizar Tabla" />
                        <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#onLimpiar" prefWidth="120.0" style="-fx-background-color: #2237c5;" text="Limpiar" textFill="WHITE" />
                    </children>
                    <padding>
                        <Insets bottom="10.0" top="10.0" />
                    </padding>
                </HBox>
            <Pane prefHeight="200.0" prefWidth="200.0" />

                <TableView fx:id="tblLibros" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colTitulo" prefWidth="180.0" text="Título" />
                        <TableColumn fx:id="colAutor" prefWidth="150.0" text="Autor" />
                        <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoría" />
                        <TableColumn fx:id="colPrecio" prefWidth="90.0" text="Precio" />
                        <TableColumn fx:id="colStock" prefWidth="90.0" text="Stock" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>
